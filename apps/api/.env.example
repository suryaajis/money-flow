# Database — the database itself must already exist; migrations don't create it.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=money_flow

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Server
PORT=3001
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# WhatsApp bot (Meta Cloud API). Without these the bot logs to console instead
# of sending real messages, so local dev works without any credentials.
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=money-flow-verify
# Public base URL of this API, used to build the CSV export link (CMD-09).
PUBLIC_API_URL=http://localhost:3001/api

# AI NLP parser (Google AI Studio, free tier). Optional — falls back to the
# built-in template parser when unset or rate-limited.
GEMINI_API_KEY=
