{
  "name": "money-flow",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "build:api": "npm run build --workspace=apps/api",
    "migration:generate": "npm run migration:generate --workspace=apps/api --",
    "migration:run": "npm run migration:run --workspace=apps/api",
    "migration:revert": "npm run migration:revert --workspace=apps/api",
    "migration:show": "npm run migration:show --workspace=apps/api",
    "whatsapp:templates:sync": "npm run whatsapp:templates:sync --workspace=apps/api --",
    "seed": "npm run seed --workspace=apps/api",
    "dist:migration:generate": "npm run dist:migration:generate --workspace=apps/api --",
    "dist:migration:run": "npm run dist:migration:run --workspace=apps/api",
    "dist:migration:revert": "npm run dist:migration:revert --workspace=apps/api",
    "dist:migration:show": "npm run dist:migration:show --workspace=apps/api",
    "dist:seed": "npm run dist:seed --workspace=apps/api",
    "lint": "npm run lint --workspaces --if-present",
    "dev:install": "npm install --workspace=apps/api && npm install --workspace=apps/web"
  }
}
