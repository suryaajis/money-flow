# Database — the database itself must already exist; migrations don't create it.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=money_flow

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=30d

# Server
PORT=3001
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# WhatsApp voice notes (VN-01..05). Transcription uses Groq's free Whisper API.
# Requires WA_ACCESS_TOKEN (to download the audio from Meta) and GROQ_API_KEY.
# Without these, the bot asks the user to type instead.
GROQ_API_KEY=
# WhatsApp bot (Meta Cloud API). Without these the bot logs to console instead
# of sending real messages, so local dev works without any credentials.
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
# WhatsApp Business Account ID, dipakai untuk create/verify message templates.
WA_WABA_ID=
# Nomor publik pengirim dalam format internasional tanpa +, dipakai untuk link wa.me.
WA_BUSINESS_PHONE_NUMBER=628123456789
# App Dashboard → Settings → Basic → App secret. Wajib untuk validasi webhook production.
WA_APP_SECRET=
WA_VERIFY_TOKEN=money-flow-verify
WA_GRAPH_API_VERSION=v25.0
WA_REQUEST_TIMEOUT_MS=10000
WA_LINK_TOKEN_TTL_MINUTES=10

# Nama template Utility yang sudah APPROVED di WhatsApp Manager.
WA_TEMPLATE_LANGUAGE=id
WA_TEMPLATE_MONTHLY_RECAP=moneyflow_monthly_recap
WA_TEMPLATE_OVER_BUDGET=moneyflow_budget_alert
WA_TEMPLATE_DEBT_DUE=moneyflow_debt_due
WA_TEMPLATE_SHARED_WALLET=moneyflow_shared_wallet_activity
# Public base URL of this API, used to build the CSV export link (CMD-09).
PUBLIC_API_URL=http://localhost:3001/api

# AI NLP parser (Google AI Studio, free tier). Optional — falls back to the
# built-in template parser when unset or rate-limited.
GEMINI_API_KEY=
